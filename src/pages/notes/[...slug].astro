---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { seriesOf } from '../../data/series';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n, all: notes } }));
}

const { note, all } = Astro.props;
const { Content, headings } = await render(note);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// 专题:按 src/data/series.ts 的阅读顺序
const ser = seriesOf(note.id);
const byId = new Map(all.map((n) => [n.id, n]));
const series = ser ? ser.notes.map((id) => byId.get(id)).filter((n) => n !== undefined) : [];
const idx = series.findIndex((n) => n.id === note.id);
const prev = idx > 0 ? series[idx - 1] : undefined;
const next = idx >= 0 && idx < series.length - 1 ? series[idx + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={`${note.data.title} · athebear`} description={note.data.summary} math={true} bodyClass="reading">
<script is:inline slot="head">
  try { if (localStorage.getItem('immersive') === '1') document.documentElement.classList.add('immersive'); } catch (e) {}
</script>
<div class="read-progress" id="read-progress" aria-hidden="true"></div>
<button class="immersive-btn" id="immersive-toggle" type="button" aria-pressed="false" title="沉浸阅读（快捷键 I，Esc 退出）">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path class="ib-enter" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/><path class="ib-exit" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"/></svg>
  <span class="ib-label">沉浸阅读</span>
</button>
<div class="doc">
  <aside class="doc-side" aria-label="专题章节">
    {ser && series.length > 1 ? (
      <details open id="side-details">
        <summary class="side-series">{ser.name}<small>第 {idx + 1} 篇，共 {series.length} 篇</small></summary>
        <ol class="side-list">
          {series.map((n) => (
            <li>
              {n.id === note.id
                ? <span class="side-on" aria-current="page">{n.data.title}</span>
                : <a href={`/notes/${n.id}/`}>{n.data.title}</a>}
            </li>
          ))}
        </ol>
        <a class="side-back" href="/notes/">全部笔记</a>
      </details>
    ) : (
      <a class="side-back" href="/notes/">全部笔记</a>
    )}
  </aside>

  <div class="doc-main">
    <header class="doc-head">
      <h1>{note.data.title}</h1>
      {note.data.summary && <p class="read-summary">{note.data.summary}</p>}
      <div class="meta">
        <time datetime={fmt(note.data.date)}>{fmt(note.data.date)}</time>
        {note.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <article class="prose doc-prose">
      <Content />
    </article>

    {(prev || next) && (
      <nav class="pager" aria-label="上一篇与下一篇">
        {prev ? (
          <a class="pager-link prev" href={`/notes/${prev.id}/`}>
            <span class="pager-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg></span>
            <span class="pager-text"><span class="pager-dir">上一篇</span><span class="pager-title">{prev.data.title}</span></span>
            <span class="pager-num" aria-hidden="true">{String(idx).padStart(2, '0')}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pager-link next" href={`/notes/${next.id}/`}>
            <span class="pager-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            <span class="pager-text"><span class="pager-dir">下一篇</span><span class="pager-title">{next.data.title}</span></span>
            <span class="pager-num" aria-hidden="true">{String(idx + 2).padStart(2, '0')}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </div>

  {toc.length > 2 ? (
    <aside class="doc-toc read-toc-wrap" aria-label="本页目录">
      <div class="read-toc-title">本页目录</div>
      <ol class="read-toc-list">
        {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </aside>
  ) : <aside class="doc-toc" aria-hidden="true" />}
</div>
</Base>

<script is:inline>
  (function () {
    var bar = document.getElementById('read-progress');
    var side = document.getElementById('side-details');
    if (side && window.matchMedia('(max-width: 820px)').matches) side.removeAttribute('open');
    if (side && !window.matchMedia('(max-width: 820px)').matches) {
      side.addEventListener('toggle', function () { if (!side.open) side.open = true; });
      var on = side.querySelector('.side-on');
      var box = side.parentElement;
      if (on && box) box.scrollTop = on.offsetTop - box.clientHeight / 2;
    }
    // 代码块:包一层标题栏(文件名或语言 + 复制按钮),4 行以上加行号
    var LANG = { python: 'Python', py: 'Python', bash: 'Shell', sh: 'Shell', shell: 'Shell', json: 'JSON', text: '输出', plaintext: '输出', js: 'JavaScript', javascript: 'JavaScript', ts: 'TypeScript', typescript: 'TypeScript', yaml: 'YAML', toml: 'TOML', sql: 'SQL', go: 'Go', rust: 'Rust', java: 'Java', cpp: 'C++', c: 'C' };
    Array.prototype.forEach.call(document.querySelectorAll('.doc-prose pre.astro-code'), function (pre) {
      var box = document.createElement('div');
      box.className = 'code-box';
      var head = document.createElement('div');
      head.className = 'code-head';
      var title = document.createElement('span');
      title.className = 'code-title';
      var lang = (pre.getAttribute('data-language') || '').toLowerCase();
      title.textContent = pre.getAttribute('data-title') || LANG[lang] || lang || '代码';
      var copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'code-copy';
      copy.textContent = '复制';
      copy.setAttribute('aria-label', '复制这段代码');
      copy.addEventListener('click', function () {
        var text = pre.innerText.replace(/\n$/, '');
        var done = function () {
          copy.textContent = '已复制';
          copy.classList.add('done');
          setTimeout(function () { copy.textContent = '复制'; copy.classList.remove('done'); }, 1600);
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(done, function () { copy.textContent = '复制失败'; });
        } else {
          var ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); done(); } catch (e) { copy.textContent = '复制失败'; }
          document.body.removeChild(ta);
        }
      });
      head.appendChild(title);
      head.appendChild(copy);
      pre.parentNode.insertBefore(box, pre);
      box.appendChild(head);
      box.appendChild(pre);
      var isOutput = lang === 'text' || lang === 'plaintext' || lang === '';
      if (!isOutput && pre.querySelectorAll('.line').length >= 4) box.classList.add('numbered');
    });

    var links = Array.prototype.slice.call(document.querySelectorAll('.read-toc-list a'));
    var heads = links.map(function (a) { return document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1))); });
    function onScroll() {
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      if (bar) bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, h.scrollTop / max) : 0) + ')';
      var cur = -1;
      for (var i = 0; i < heads.length; i++) { if (heads[i] && heads[i].getBoundingClientRect().top < 100) cur = i; }
      links.forEach(function (a, i) { a.classList.toggle('on', i === cur); });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 沉浸阅读:隐藏顶栏、两侧栏与页脚;切换前后让正在读的段落停在原位
    var root = document.documentElement;
    var btn = document.getElementById('immersive-toggle');
    var label = btn.querySelector('.ib-label');
    var blocks = Array.prototype.slice.call(document.querySelectorAll('.doc-head, .doc-prose > *'));
    function sync() {
      var on = root.classList.contains('immersive');
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      label.textContent = on ? '退出沉浸' : '沉浸阅读';
    }
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    function setImmersive(on) {
      if (on === root.classList.contains('immersive')) return;
      if (document.startViewTransition && !reduceMotion.matches) {
        document.startViewTransition(function () { applyImmersive(on); });
      } else {
        applyImmersive(on);
      }
    }
    function applyImmersive(on) {
      // 记下视线所在的块、以及读到它的几分之几;字号变化后按同一比例对齐回视线
      var line = Math.min(160, window.innerHeight / 3), anchor = null, ratio = 0;
      for (var i = 0; i < blocks.length; i++) {
        var r = blocks[i].getBoundingClientRect();
        if (r.bottom > line) { anchor = blocks[i]; ratio = r.height ? Math.max(0, (line - r.top) / r.height) : 0; break; }
      }
      root.classList.toggle('immersive', on);
      if (anchor) {
        var r2 = anchor.getBoundingClientRect();
        window.scrollBy(0, r2.top + ratio * r2.height - line);
      }
      try { localStorage.setItem('immersive', on ? '1' : '0'); } catch (e) {}
      sync();
      onScroll();
    }
    btn.addEventListener('click', function () { setImmersive(!root.classList.contains('immersive')); });
    document.addEventListener('keydown', function (e) {
      var t = e.target;
      if (e.metaKey || e.ctrlKey || e.altKey || (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)))) return;
      if (e.key === 'i' || e.key === 'I') { e.preventDefault(); setImmersive(!root.classList.contains('immersive')); }
      else if (e.key === 'Escape' && root.classList.contains('immersive')) setImmersive(false);
    });
    sync();

    // 看图:点正文里的图在本页放大,不再跳新标签页;←/→ 切换,点图放大细节,Esc 或点空白处关闭
    // 链接本身保留,没有 JS 或按住 ⌘/Ctrl 点击时照旧打开原图
    var IMG_URL = /\.(jpe?g|png|webp|gif|avif|svg)(\?|#|$)/i;
    var shots = [];
    Array.prototype.forEach.call(document.querySelectorAll('.doc-prose img'), function (img) {
      var a = img.closest('a');
      if (a && !IMG_URL.test(a.getAttribute('href') || '')) return; // 图片链到别的页面,不接管
      var fig = img.closest('figure');
      var cap = fig && fig.querySelector('figcaption');
      shots.push({
        img: img,
        link: a,
        src: a ? a.href : (img.currentSrc || img.src),
        caption: (cap ? cap.textContent : img.alt || '').replace(/[（(]\s*点击查看原图\s*[)）]/g, '').trim()
      });
    });
    if (!shots.length || !window.HTMLDialogElement) return;

    var ARROW = '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    var dlg = document.createElement('dialog');
    dlg.className = 'lb';
    dlg.setAttribute('aria-label', '查看图片');
    dlg.tabIndex = -1;
    dlg.innerHTML =
      '<div class="lb-bar">' +
        '<span class="lb-count"></span>' +
        '<a class="lb-orig" target="_blank" rel="noopener">原图</a>' +
        '<button type="button" class="lb-close" aria-label="关闭"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>' +
      '</div>' +
      '<div class="lb-stage"><img class="lb-img" alt="" decoding="async"></div>' +
      '<button type="button" class="lb-nav lb-prev" aria-label="上一张">' + ARROW + '</button>' +
      '<button type="button" class="lb-nav lb-next" aria-label="下一张">' + ARROW + '</button>' +
      '<p class="lb-cap" aria-live="polite"></p>';
    document.body.appendChild(dlg);
    var stage = dlg.querySelector('.lb-stage');
    var big = dlg.querySelector('.lb-img');
    var count = dlg.querySelector('.lb-count');
    var orig = dlg.querySelector('.lb-orig');
    var capEl = dlg.querySelector('.lb-cap');
    var idx = 0;
    if (shots.length < 2) dlg.classList.add('single');

    function render(i) {
      idx = (i + shots.length) % shots.length;
      var s = shots[idx];
      setZoom(false);
      big.src = s.src;
      big.alt = s.img.alt || '';
      capEl.textContent = s.caption;
      capEl.hidden = !s.caption;
      count.textContent = shots.length > 1 ? (idx + 1) + ' / ' + shots.length : '';
      orig.href = s.src;
      [1, -1].forEach(function (d) { new Image().src = shots[(idx + d + shots.length) % shots.length].src; });
    }
    function open(i) {
      render(i);
      root.classList.add('lb-open');
      dlg.showModal();
      dlg.focus(); // 焦点放在对话框上,别让第一个按钮一打开就亮起描边
      if (reduceMotion.matches || !big.animate) return;
      // 从正文里那张图的位置放大出来
      var from = shots[idx].img.getBoundingClientRect();
      var grow = function () {
        var r = big.getBoundingClientRect();
        if (!r.width || !from.width) return;
        big.animate([
          { transform: 'translate(' + (from.left - r.left) + 'px,' + (from.top - r.top) + 'px) scale(' + (from.width / r.width) + ')' },
          { transform: 'none' }
        ], { duration: 340, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
      };
      if (big.complete && big.naturalWidth) grow(); else big.addEventListener('load', grow, { once: true });
    }
    function setZoom(on, x, y) {
      if (!on) { dlg.classList.remove('zoomed'); big.style.width = ''; return; }
      var r = big.getBoundingClientRect();
      var fx = (x - r.left) / r.width, fy = (y - r.top) / r.height;
      dlg.classList.add('zoomed');
      big.style.width = Math.round(Math.max(big.naturalWidth, r.width * 1.8)) + 'px';
      // 放大后让点到的位置停在视野中央
      stage.scrollLeft = fx * big.offsetWidth - stage.clientWidth / 2;
      stage.scrollTop = fy * big.offsetHeight - stage.clientHeight / 2;
    }

    shots.forEach(function (s, i) {
      var el = s.link || s.img;
      if (!s.link) {
        s.img.tabIndex = 0;
        s.img.setAttribute('role', 'button');
        s.img.setAttribute('aria-label', '放大查看：' + (s.img.alt || '图片'));
        s.img.style.cursor = 'zoom-in';
        s.img.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); }
        });
      }
      el.addEventListener('click', function (e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        open(i);
      });
    });

    big.addEventListener('click', function (e) {
      setZoom(!dlg.classList.contains('zoomed'), e.clientX, e.clientY);
    });
    dlg.querySelector('.lb-prev').addEventListener('click', function () { render(idx - 1); });
    dlg.querySelector('.lb-next').addEventListener('click', function () { render(idx + 1); });
    dlg.querySelector('.lb-close').addEventListener('click', function () { dlg.close(); });
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg || e.target === stage || e.target.classList.contains('lb-bar')) dlg.close();
    });
    dlg.addEventListener('close', function () { root.classList.remove('lb-open'); setZoom(false); });
    dlg.addEventListener('keydown', function (e) {
      e.stopPropagation(); // 别让 I / Esc 同时触发沉浸阅读
      if (e.key === 'ArrowLeft') { e.preventDefault(); render(idx - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); render(idx + 1); }
    });
    // 手机上左右滑动切换;放大状态下滑动是拖动画面,不切换
    var touchX = null, touchY = 0;
    stage.addEventListener('touchstart', function (e) {
      if (e.touches.length !== 1 || dlg.classList.contains('zoomed')) { touchX = null; return; }
      touchX = e.touches[0].clientX; touchY = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (touchX === null) return;
      var dx = e.changedTouches[0].clientX - touchX, dy = e.changedTouches[0].clientY - touchY;
      touchX = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && shots.length > 1) render(idx + (dx < 0 ? 1 : -1));
    });
  })();
</script>
