---
import Base from '../layouts/Base.astro';
import PillIcon from '../components/PillIcon.astro';
import { getCollection } from 'astro:content';
import { SERIES, seriesOf } from '../data/series';
import plan from '../data/prep-plan.json';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const all = await getCollection('notes', ({ data }) => !data.draft);
const byId = new Map(all.map((n) => [n.id, n]));
const series = SERIES.map((s) => ({
  ...s,
  count: s.notes.filter((id) => byId.has(id)).length,
  hub: byId.get(s.notes[0]),
  picks: s.notes.slice(1, 5).map((id) => byId.get(id)).filter((n) => n !== undefined),
}));
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// 首屏终端:每条演示都是一次 ReAct 循环,内容取自真实的专题与笔记数据
const short = (t: string) => t.split(/[:：？?]/)[0];
const link = (id: string) => ({ href: `/notes/${id}/`, text: short(byId.get(id)?.data.title ?? id) });
const eng = series.find((s) => s.key === 'agent-eng');
const agent = series.find((s) => s.key === 'agent');
const mm = series.find((s) => s.key === 'multimodal');
const traces = [
  {
    ask: '这个博客有什么？',
    steps: [
      { k: 'thought', t: '先看看一共有哪些专题。' },
      { k: 'action', t: 'run_command("ls notes/")' },
      { k: 'obs', t: series.map((s) => `${s.key}/ (${s.count})`).join('   ') },
      { k: 'thought', t: `${series.length} 个专题，共 ${all.length} 篇。想边敲代码边学，就从 Agent 工程实战开始。` },
    ],
    links: series.map((s) => ({ href: `/notes/${s.notes[0]}/`, text: s.name })),
  },
  eng && agent && {
    ask: 'Agent 从哪开始读？',
    steps: [
      { k: 'thought', t: '工程和算法是两条线，都列出来。' },
      { k: 'action', t: 'run_command("cat notes/agent-eng/README")' },
      { k: 'obs', t: eng.notes.filter((id) => byId.has(id)).map((id, i) => `${String(i + 1).padStart(2, '0')}  ${short(byId.get(id)!.data.title)}`).join('\n') },
      { k: 'thought', t: '想自己写 Harness，读工程线；准备算法面试，读 Agent 算法总览。' },
    ],
    links: [link(eng.notes[eng.notes.length > 1 ? 1 : 0]), link(agent.notes[0])],
  },
  {
    ask: '最近更新了什么？',
    steps: [
      { k: 'thought', t: '按时间排一下，取最新的三篇。' },
      { k: 'action', t: 'run_command("ls -t notes/ | head -3")' },
      { k: 'obs', t: notes.slice(0, 3).map((n) => `${fmt(n.data.date)}  ${short(n.data.title)}`).join('\n') },
    ],
    links: notes.slice(0, 3).map((n) => link(n.id)),
  },
  mm && {
    ask: '多模态怎么入门？',
    steps: [
      { k: 'thought', t: '多模态专题有总览，先看它推荐的前几篇。' },
      { k: 'action', t: 'run_command("head -4 notes/multimodal/README")' },
      { k: 'obs', t: mm.picks.map((n, i) => `${String(i + 1).padStart(2, '0')}  ${short(n.data.title)}`).join('\n') },
      { k: 'thought', t: `一共 ${mm.count} 篇，从总览开始最稳。` },
    ],
    links: [link(mm.notes[0])],
  },
].filter(Boolean);
// 看板横幅:只把日期、主题和节点交给客户端,按访问当天显示
const planLite = {
  days: plan.days.map((d) => ({ date: d.date, theme: d.theme })),
  milestones: plan.milestones,
};
---
<Base title="Xinran Xiong · athebear" bodyClass="home-page">
<Fragment slot="head">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
</Fragment>
<div class="container">

  <header class="term-hero">
    <div class="term-intro">
      <h1 class="term-name" lang="en">Athebear</h1>
      <p class="term-who">熊昕然 <span lang="en">Xinran Xiong</span></p>
      <p class="term-tagline">做多模态研究，也在从零手写 Agent Harness。这里放我的研究笔记、手敲教程和互动课程。</p>
      <ul class="term-tracks" aria-label="方向">
        <li><b>多模态</b>视觉语言模型、跨模态检索、对比学习</li>
        <li><b>Agent</b>工具调用、上下文管理、从零写 Harness</li>
      </ul>
      <div class="hero-actions">
        <a class="hero-btn primary" href="/notes/">读笔记</a>
        <a class="hero-btn" href="/teaching/">互动课程</a>
        <a class="hero-link" href="https://github.com/Thebearcoding" target="_blank" rel="noopener">GitHub</a>
        <a class="hero-link" href="mailto:hello@athebear.me">Email</a>
      </div>
    </div>

    <section class="term" aria-label="演示：一个 Agent 帮你逛这个博客">
      <div class="term-bar">
        <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="term-title">athebear@harness: ~</span>
        <button class="term-replay" id="term-replay" type="button">再跑一次</button>
      </div>
      <div class="term-body" id="term-body" aria-live="polite"></div>
      <div class="term-asks" role="group" aria-label="换一个问题问它">
        {traces.map((t, i) => <button type="button" class="term-ask" data-i={i}>{t.ask}</button>)}
      </div>
    </section>
  </header>
  <script is:inline type="application/json" id="term-traces" set:html={JSON.stringify(traces)}></script>
  <script is:inline>
    (function () {
      var traces = JSON.parse(document.getElementById('term-traces').textContent);
      var body = document.getElementById('term-body');
      var asks = Array.prototype.slice.call(document.querySelectorAll('.term-ask'));
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var LABEL = { thought: 'Thought', action: 'Action', obs: 'Observation' };
      var run = 0, current = 0;
      function line(cls, label) {
        var row = document.createElement('div');
        row.className = 'term-line ' + cls;
        if (label) { var l = document.createElement('span'); l.className = 'term-k'; l.textContent = label; row.appendChild(l); }
        var v = document.createElement('span'); v.className = 'term-v'; row.appendChild(v);
        body.appendChild(row);
        body.scrollTop = body.scrollHeight;
        return v;
      }
      function wait(ms, id) { return new Promise(function (r) { setTimeout(function () { r(id === run); }, reduce ? 0 : ms); }); }
      function type(el, text, id, speed) {
        if (reduce) { el.textContent = text; return Promise.resolve(true); }
        return new Promise(function (resolve) {
          var i = 0;
          (function tick() {
            if (id !== run) return resolve(false);
            i += 1; el.textContent = text.slice(0, i);
            body.scrollTop = body.scrollHeight;
            if (i < text.length) setTimeout(tick, speed); else resolve(true);
          })();
        });
      }
      async function play(idx) {
        var id = ++run; current = idx;
        var t = traces[idx];
        asks.forEach(function (b, i) { b.setAttribute('aria-pressed', i === idx ? 'true' : 'false'); });
        body.textContent = '';
        if (!(await type(line('ask', '>'), t.ask, id, 45))) return;
        for (var s = 0; s < t.steps.length; s++) {
          var st = t.steps[s];
          if (!(await wait(st.k === 'obs' ? 520 : 260, id))) return;
          var v = line(st.k, LABEL[st.k]);
          if (st.k === 'obs') { v.classList.add('running'); if (!(await wait(420, id))) return; v.classList.remove('running'); v.textContent = st.t; body.scrollTop = body.scrollHeight; }
          else if (!(await type(v, st.t, id, st.k === 'action' ? 22 : 26))) return;
        }
        if (!(await wait(300, id))) return;
        var f = line('final', 'Final');
        t.links.forEach(function (lk) { var a = document.createElement('a'); a.href = lk.href; a.textContent = lk.text; f.appendChild(a); });
        body.scrollTop = body.scrollHeight;
      }
      asks.forEach(function (b) { b.addEventListener('click', function () { play(+b.getAttribute('data-i')); }); });
      document.getElementById('term-replay').addEventListener('click', function () { play(current); });
      play(0);
    })();
  </script>

  <a class="now-banner" href="/plan/">
    <span class="now-tag">进行中</span>
    <span class="now-main">
      <b>28 届算法实习备战看板</b>
      <span class="now-today" id="now-today">每天的时间块、任务和教程链接</span>
    </span>
    <span class="now-next" id="now-next"></span>
    <span class="now-go">打开看板</span>
  </a>
  <script is:inline type="application/json" id="plan-lite" set:html={JSON.stringify(planLite)}></script>
  <script is:inline>
    (function () {
      try {
        var p = JSON.parse(document.getElementById('plan-lite').textContent);
        var d = new Date(); var iso = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        var day = p.days.find(function (x) { return x.date === iso; });
        if (day) document.getElementById('now-today').textContent = '今天 · ' + day.theme;
        var m = p.milestones.find(function (x) { return x.date >= iso; });
        if (m) {
          var n = Math.round((new Date(m.date + 'T00:00:00') - new Date(iso + 'T00:00:00')) / 864e5);
          document.getElementById('now-next').textContent = (n === 0 ? '今天' : n + ' 天后') + ' · ' + m.name;
        }
      } catch (e) {}
    })();
  </script>

  <section class="section">
    <div class="section-head">
      <h2 data-en="Topics">专题</h2>
      <a class="more" href="/notes/">全部 {all.length} 篇笔记</a>
    </div>
    <div class="topic-grid">
      {series.map((s) => (
        <article class="topic-card">
          <div class="topic-top">
            <h3><a href={`/notes/${s.notes[0]}/`}>{s.name}</a></h3>
            <span class="topic-count">{s.count} 篇</span>
          </div>
          <p class="topic-desc">{s.desc}</p>
          <ol class="topic-picks">
            {s.picks.map((n) => <li><a href={`/notes/${n.id}/`}>{n.data.title.split(/[:：]/)[0]}</a></li>)}
          </ol>
          <div class="topic-actions">
            <a class="topic-start" href={`/notes/${s.notes[0]}/`}>从总览开始</a>
            <a class="topic-all" href={`/notes/#s-${s.key}`}>目录</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-en="Courses &amp; tools">课程与工具</h2>
      <a class="more" href="/teaching/">全部教学与学习</a>
    </div>
    <div class="card-grid card-grid-3">
      <a class="t-card" href="https://athebear.me/minimind-v-course/course/" target="_blank" rel="noopener">
        <span class="t-status live">互动课程 · 12 课</span>
        <h3>MiniMind-V:从零看懂并训练一个视觉语言模型</h3>
        <p>以 65M 参数的开源 VLM 为骨架,拆解结构、训练与推理。每课 4~5 个交互动画、真实源码逐行讲解和零依赖练习。</p>
        <span class="t-go">开始学习</span>
      </a>
      <a class="t-card" href="https://athebear.me/defect-detection-course/" target="_blank" rel="noopener">
        <span class="t-status live">互动课程 · 13 课</span>
        <h3>缺陷检测:从深度学习基础到主流方法全景</h3>
        <p>工业缺陷检测中文交互课程,30+ 交互演示,从卷积讲到主流检测范式,配零依赖 Python 练习。</p>
        <span class="t-go">开始学习</span>
      </a>
      <a class="t-card" href="https://paper.athebear.me" target="_blank" rel="noopener">
        <span class="t-status live">在线工具</span>
        <h3>Paper Insight:论文初筛工具</h3>
        <p>按会议批量浏览论文,自动回答四个初筛问题:代码开源吗、什么任务、什么指标、为何优于基线;支持 arXiv 直投与全文对话。</p>
        <span class="t-go">开始筛论文</span>
      </a>
    </div>
    <div class="repo-strip">
      <span class="repo-label">代码与学习仓库</span>
      <a href="https://github.com/Thebearcoding/minimind-v-course" target="_blank" rel="noopener">MiniMind-V 从零复现 ↗</a>
      <a href="https://github.com/Thebearcoding/assignment1-basics" target="_blank" rel="noopener">CS336 作业 ↗</a>
      <a href="https://github.com/Thebearcoding/cs336-mllm-learning" target="_blank" rel="noopener">CS336 多模态笔记 ↗</a>
      <a href="https://github.com/Thebearcoding/ARIS-in-AI-Offer" target="_blank" rel="noopener">AI 面试速查 ↗</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-en="Recently">最近更新</h2>
      <a class="more" href="/rss.xml">RSS 订阅</a>
    </div>
    <ul class="recent-list">
      {notes.map((n) => {
        const s = seriesOf(n.id);
        return (
          <li>
            <time datetime={fmt(n.data.date)}>{fmt(n.data.date)}</time>
            <a href={`/notes/${n.id}/`}>{n.data.title}</a>
            {s && <span class="recent-series">{s.name}</span>}
          </li>
        );
      })}
    </ul>
  </section>

</div>
</Base>
