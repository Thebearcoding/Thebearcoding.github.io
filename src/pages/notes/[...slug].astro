---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { seriesOf } from '../../data/series';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n, all: notes } }));
}

const { note, all } = Astro.props;
const { Content, headings } = await render(note);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// 专题:按 src/data/series.ts 的阅读顺序
const ser = seriesOf(note.id);
const byId = new Map(all.map((n) => [n.id, n]));
const series = ser ? ser.notes.map((id) => byId.get(id)).filter((n) => n !== undefined) : [];
const idx = series.findIndex((n) => n.id === note.id);
const prev = idx > 0 ? series[idx - 1] : undefined;
const next = idx >= 0 && idx < series.length - 1 ? series[idx + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={`${note.data.title} · athebear`} description={note.data.summary} math={true} bodyClass="reading">
<div class="read-progress" id="read-progress" aria-hidden="true"></div>
<div class="doc">
  <aside class="doc-side" aria-label="专题章节">
    {ser && series.length > 1 ? (
      <details open id="side-details">
        <summary class="side-series">{ser.name}<small>第 {idx + 1} 篇，共 {series.length} 篇</small></summary>
        <ol class="side-list">
          {series.map((n) => (
            <li>
              {n.id === note.id
                ? <span class="side-on" aria-current="page">{n.data.title}</span>
                : <a href={`/notes/${n.id}/`}>{n.data.title}</a>}
            </li>
          ))}
        </ol>
        <a class="side-back" href="/notes/">全部笔记</a>
      </details>
    ) : (
      <a class="side-back" href="/notes/">全部笔记</a>
    )}
  </aside>

  <div class="doc-main">
    <header class="doc-head">
      <h1>{note.data.title}</h1>
      {note.data.summary && <p class="read-summary">{note.data.summary}</p>}
      <div class="meta">
        <time datetime={fmt(note.data.date)}>{fmt(note.data.date)}</time>
        {note.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <article class="prose doc-prose">
      <Content />
    </article>

    {(prev || next) && (
      <nav class="pager" aria-label="上一篇与下一篇">
        {prev ? <a class="pager-link" href={`/notes/${prev.id}/`}><span>上一篇</span>{prev.data.title}</a> : <span />}
        {next ? <a class="pager-link next" href={`/notes/${next.id}/`}><span>下一篇</span>{next.data.title}</a> : <span />}
      </nav>
    )}
  </div>

  {toc.length > 2 ? (
    <aside class="doc-toc read-toc-wrap" aria-label="本页目录">
      <div class="read-toc-title">本页目录</div>
      <ol class="read-toc-list">
        {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </aside>
  ) : <aside class="doc-toc" aria-hidden="true" />}
</div>
</Base>

<script is:inline>
  (function () {
    var bar = document.getElementById('read-progress');
    var side = document.getElementById('side-details');
    if (side && window.matchMedia('(max-width: 820px)').matches) side.removeAttribute('open');
    if (side && !window.matchMedia('(max-width: 820px)').matches) {
      side.addEventListener('toggle', function () { if (!side.open) side.open = true; });
      var on = side.querySelector('.side-on');
      var box = side.parentElement;
      if (on && box) box.scrollTop = on.offsetTop - box.clientHeight / 2;
    }
    var links = Array.prototype.slice.call(document.querySelectorAll('.read-toc-list a'));
    var heads = links.map(function (a) { return document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1))); });
    function onScroll() {
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      if (bar) bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, h.scrollTop / max) : 0) + ')';
      var cur = -1;
      for (var i = 0; i < heads.length; i++) { if (heads[i] && heads[i].getBoundingClientRect().top < 100) cur = i; }
      links.forEach(function (a, i) { a.classList.toggle('on', i === cur); });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
