---
import Base from '../layouts/Base.astro';
import PillIcon from '../components/PillIcon.astro';
import { getCollection } from 'astro:content';
import { SERIES, seriesOf } from '../data/series';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const all = await getCollection('notes', ({ data }) => !data.draft);
const byId = new Map(all.map((n) => [n.id, n]));
const series = SERIES.map((s) => ({
  ...s,
  count: s.notes.filter((id) => byId.has(id)).length,
  hub: byId.get(s.notes[0]),
  picks: s.notes.slice(1, 5).map((id) => byId.get(id)).filter((n) => n !== undefined),
}));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Xinran Xiong · athebear" bodyClass="home-page">
<div class="container">

  <header class="hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="hero-copy">
      <div class="hero-intro">
        <a
          class="hero-avatar-link"
          href="https://github.com/Thebearcoding"
          target="_blank"
          rel="noopener"
          aria-label="在 GitHub 查看 Thebearcoding"
        >
          <img
            class="hero-avatar"
            src="/images/github-avatar.png"
            alt="Xinran Xiong 的 GitHub 头像"
            width="460"
            height="460"
          />
        </a>
        <div>
          <span class="kicker">MULTIMODAL · ML RESEARCH</span>
          <h1>Xinran Xiong<span class="accent-dot">.</span></h1>
        </div>
      </div>
      <p class="tagline">
        多模态方向的研究者。关心视觉与语言如何在同一个空间里相遇,
        也相信 65M 参数的小模型和一支笔一样,足够把一件事讲清楚。
        这里记录我的研究笔记、想法,和亲手做的互动课程。
      </p>
      <div class="hero-chips" aria-label="研究兴趣">
        <span class="chip"><b>多模态学习</b> · 视觉-语言模型</span>
        <span class="chip">跨模态检索与对齐</span>
        <span class="chip">对比学习 · CLIP / SigLIP</span>
        <span class="chip">小模型 · 从零实现</span>
      </div>
      <div class="hero-links">
        <a class="pill-link primary" href="/notes/"><PillIcon name="notes" />读笔记</a>
        <a class="pill-link" href="/teaching/"><PillIcon name="teaching" />互动课程</a>
        <a class="pill-link" href="https://github.com/Thebearcoding" target="_blank" rel="noopener"><PillIcon name="github" />GitHub</a>
        <a class="pill-link" href="mailto:hello@athebear.me"><PillIcon name="email" />Email</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="section-head">
      <h2>专题</h2>
      <a class="more" href="/notes/">全部 {all.length} 篇笔记 →</a>
    </div>
    <div class="topic-grid">
      {series.map((s) => (
        <article class="topic-card">
          <div class="topic-top">
            <h3><a href={`/notes/${s.notes[0]}/`}>{s.name}</a></h3>
            <span class="topic-count">{s.count} 篇</span>
          </div>
          <p class="topic-desc">{s.desc}</p>
          <ol class="topic-picks">
            {s.picks.map((n) => <li><a href={`/notes/${n.id}/`}>{n.data.title.split(/[:：]/)[0]}</a></li>)}
          </ol>
          <div class="topic-actions">
            <a class="topic-start" href={`/notes/${s.notes[0]}/`}>从总览开始 →</a>
            <a class="topic-all" href={`/notes/#s-${s.key}`}>目录</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>课程与工具</h2>
      <a class="more" href="/teaching/">全部教学与学习 →</a>
    </div>
    <div class="card-grid card-grid-3">
      <a class="t-card" href="https://athebear.me/minimind-v-course/course/" target="_blank" rel="noopener">
        <span class="t-status live">互动课程 · 12 课</span>
        <h3>MiniMind-V:从零看懂并训练一个视觉语言模型</h3>
        <p>以 65M 参数的开源 VLM 为骨架,拆解结构、训练与推理。每课 4~5 个交互动画、真实源码逐行讲解和零依赖练习。</p>
        <span class="t-go">开始学习 →</span>
      </a>
      <a class="t-card" href="https://athebear.me/defect-detection-course/" target="_blank" rel="noopener">
        <span class="t-status live">互动课程 · 13 课</span>
        <h3>缺陷检测:从深度学习基础到主流方法全景</h3>
        <p>工业缺陷检测中文交互课程,30+ 交互演示,从卷积讲到主流检测范式,配零依赖 Python 练习。</p>
        <span class="t-go">开始学习 →</span>
      </a>
      <a class="t-card" href="https://paper.athebear.me" target="_blank" rel="noopener">
        <span class="t-status live">在线工具</span>
        <h3>Paper Insight:论文初筛工具</h3>
        <p>按会议批量浏览论文,自动回答四个初筛问题:代码开源吗、什么任务、什么指标、为何优于基线;支持 arXiv 直投与全文对话。</p>
        <span class="t-go">开始筛论文 →</span>
      </a>
    </div>
    <div class="repo-strip">
      <span class="repo-label">代码与学习仓库</span>
      <a href="https://github.com/Thebearcoding/minimind-v-course" target="_blank" rel="noopener">MiniMind-V 从零复现 ↗</a>
      <a href="https://github.com/Thebearcoding/assignment1-basics" target="_blank" rel="noopener">CS336 作业 ↗</a>
      <a href="https://github.com/Thebearcoding/cs336-mllm-learning" target="_blank" rel="noopener">CS336 多模态笔记 ↗</a>
      <a href="https://github.com/Thebearcoding/ARIS-in-AI-Offer" target="_blank" rel="noopener">AI 面试速查 ↗</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近更新</h2>
      <a class="more" href="/rss.xml">RSS 订阅 →</a>
    </div>
    <ul class="recent-list">
      {notes.map((n) => {
        const s = seriesOf(n.id);
        return (
          <li>
            <time datetime={fmt(n.data.date)}>{fmt(n.data.date)}</time>
            <a href={`/notes/${n.id}/`}>{n.data.title}</a>
            {s && <span class="recent-series">{s.name}</span>}
          </li>
        );
      })}
    </ul>
  </section>

</div>
</Base>
