---
interface Props {
  title: string;
  description?: string;
  math?: boolean;
  bodyClass?: string;
}
const { title, description = 'Xinran Xiong 的个人主页:多模态学习研究、互动课程与研究笔记。', math = false, bodyClass } = Astro.props;
const path = Astro.url.pathname;
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined;
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title>
<link rel="preconnect" href="https://cdn.jsdelivr.net" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css" media="print" onload="this.media='all'" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap" />
<link rel="stylesheet" href="/fonts/fonts.css" />
{math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
<link rel="alternate" type="application/rss+xml" title="笔记 RSS" href="/rss.xml" />
<slot name="head" />
</head>
<body class={bodyClass}>

<nav class="site-nav">
  <div class="nav-inner">
    <a class="nav-brand" href="/"><img src="/favicon.svg" alt="" />athebear</a>
    <div class="nav-links">
      <a href="/" aria-current={isActive('/')}>主页</a>
      <a href="/notes/" aria-current={isActive('/notes')}>笔记</a>
      <a href="/teaching/" aria-current={isActive('/teaching')}>教学与学习</a>
      <a href="https://paper.athebear.me" target="_blank" rel="noopener">论文 ↗</a>
      <a href="https://github.com/Thebearcoding" target="_blank" rel="noopener">GitHub ↗</a>
    </div>
  </div>
</nav>

<main>
  <slot />
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <span>© 2026 Xinran Xiong</span>
    <a href="/rss.xml">RSS</a>
    <a href="https://github.com/Thebearcoding" target="_blank" rel="noopener">GitHub</a>
    <span class="foot-note">暖色 · 衬线 · 反对千篇一律的 AI 风</span>
  </div>
</footer>

</body>
</html>
