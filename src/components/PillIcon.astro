---
interface Props {
  name: 'notes' | 'teaching' | 'github' | 'email';
}

const { name } = Astro.props;
---

<svg
  class={`pill-icon pill-icon--${name}`}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {name === 'notes' && (
    <>
      <path class="icon-paper" d="M5.2 4.8c3-.7 5-.5 6.8.6v14c-1.8-1.1-3.8-1.3-6.8-.6V4.8Z" />
      <path class="icon-paper" d="M18.8 4.8c-3-.7-5-.5-6.8.6v14c1.8-1.1 3.8-1.3 6.8-.6V4.8Z" />
      <path d="M7.3 8c1.3-.2 2.2-.1 3 .3M7.3 11c1.3-.2 2.2-.1 3 .3M13.8 8.2c1-.4 1.8-.5 2.9-.3" />
      <path class="icon-accent icon-fill" d="m15.2 11.1 3.6 1.5-3.6 1.6.6-1.6-.6-1.5Z" />
    </>
  )}

  {name === 'teaching' && (
    <>
      <path class="icon-paper" d="M3.8 6.5c3.2-.8 5.8-.2 8.2 1.6v11c-2.4-1.8-5-2.4-8.2-1.6v-11Z" />
      <path class="icon-paper" d="M20.2 6.5c-3.2-.8-5.8-.2-8.2 1.6v11c2.4-1.8 5-2.4 8.2-1.6v-11Z" />
      <path d="M6.2 10.2c1.5-.1 2.6.2 3.7.9M17.8 10.2c-1.5-.1-2.6.2-3.7.9" />
      <path class="icon-accent" d="M12 3.1v2.2M8.9 4l1.1 1.8M15.1 4 14 5.8" />
    </>
  )}

  {name === 'github' && (
    <>
      <path d="M7 6.2v7.1c0 1.7 1.2 3 2.9 3h4.2c1.7 0 2.9-1.3 2.9-3V9.8" />
      <circle class="icon-paper" cx="7" cy="5.2" r="2.1" />
      <circle class="icon-paper" cx="17" cy="8.8" r="2.1" />
      <circle class="icon-accent icon-fill" cx="12" cy="18.7" r="2.2" />
      <path d="M12 16.4v-5.1" />
    </>
  )}

  {name === 'email' && (
    <>
      <path class="icon-paper" d="M3.8 6.4h16.4v11.2H3.8V6.4Z" />
      <path d="m4.6 7.1 7.4 5.8 7.4-5.8M4.7 16.8l5.1-5.4M19.3 16.8l-5.1-5.4" />
      <circle class="icon-accent icon-fill" cx="17.7" cy="16.4" r="2.1" />
      <path class="icon-seal" d="m16.8 16.4.6.6 1.2-1.3" />
    </>
  )}
</svg>
